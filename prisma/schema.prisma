// Phase 4: structure only. Tables and relations for the schema outlined in
// the backend brief. No application code reads/writes these beyond what's
// needed to prove the migration succeeded and the single-active-device
// constraint holds (see infra notes on the hand-edited partial index below).
//
// Field-level detail here is a first-pass structural scaffold based on the
// table names and relationships referenced across the infra briefs — worth
// checking against the full original backend brief once Phase 5 needs real
// business logic against these tables, rather than treated as final.

// Prisma 7: the client generator has moved to driver adapters for runtime
// queries (see PrismaService), and the datasource `url` field is no longer
// valid in the schema itself — connection info for the CLI (migrate,
// generate) lives in prisma.config.ts instead.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Explicit, not auto-detected: Prisma's auto-detection misread this
  // project's "module": "nodenext" tsconfig setting as ESM, generating
  // client code that used `import.meta.url` — invalid once tsc compiles
  // everything else here down to CommonJS (no "type": "module" in
  // package.json). Result was a runtime crash: "exports is not defined
  // in ES module scope". Verified live against the actual container.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  keycloakId String   @unique @map("keycloak_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  devices                  Device[]
  conversationMemberships  ConversationParticipant[]
  sentMessages             Message[]
  pendingDeviceSwitches    PendingDeviceSwitch[]
  pendingPasswordResets    PendingPasswordReset[]

  @@map("users")
}

model Device {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  deviceFingerprint String   @map("device_fingerprint")
  // Single-active-device is enforced at the database level via a partial
  // unique index (WHERE is_active = true), not by this column alone.
  // Prisma has no first-class syntax for partial unique indexes — the
  // generated migration is hand-edited to add it. See
  // prisma/migrations/*_init/migration.sql and infra/README.md.
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  lastSeenAt        DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  // Server never sees plaintext — this is ciphertext produced client-side.
  ciphertext     String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model PendingDeviceSwitch {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  newDeviceFingerprint String   @map("new_device_fingerprint")
  status               String   @default("pending")
  requestedAt          DateTime @default(now()) @map("requested_at")
  expiresAt            DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_device_switch")
}

model PendingPasswordReset {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tokenHash   String   @map("token_hash")
  requestedAt DateTime @default(now()) @map("requested_at")
  expiresAt   DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_password_reset")
}
