# eslint-config-airbnb-base declares a peer dep on ESLint ^7.32.0 || ^8.2.0,
# and eslint-config-airbnb-typescript on @typescript-eslint ^7.0.0 — this
# project is on ESLint 9 / @typescript-eslint 8. Verified live that the
# rule sets themselves load and run correctly despite the declared
# mismatch (see eslint.config.mjs). Without this, even `npm ci --omit=dev`
# fails outright — npm validates peer deps against the full lockfile
# (including devDependencies) before filtering down to what actually gets
# installed, so the conflict blocks the production Docker stage too, not
# just local dev installs.
legacy-peer-deps=true
