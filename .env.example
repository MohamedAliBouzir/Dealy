# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.
# These are placeholder values only.

# ---- Reverse proxy (public-facing) ----
HTTP_PORT=8080
HTTPS_PORT=8443

# ---- app-db (dedicated Postgres for the future NestJS app) ----
APP_DB_USER=dealy_app
APP_DB_PASSWORD=changeme_in_real_env
APP_DB_NAME=dealy

# ---- keycloak-db (dedicated Postgres for Keycloak — never shared with app-db) ----
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme_in_real_env
KEYCLOAK_DB_NAME=keycloak

# ---- Keycloak ----
KEYCLOAK_ADMIN_USER=kc_admin
KEYCLOAK_ADMIN_PASSWORD=changeme_in_real_env
# Hostname Keycloak believes it's served from (reached only via reverse-proxy).
KEYCLOAK_HOSTNAME=localhost

# ---- Redis ----
REDIS_PASSWORD=changeme_in_real_env

# ---- MinIO ----
MINIO_ROOT_USER=dealy_minio
MINIO_ROOT_PASSWORD=changeme_in_real_env
